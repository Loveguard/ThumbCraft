{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThumbCraft",
  "version": "0.5.0",
  "identifier": "com.thumbcraft.app",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../out/renderer"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Loveguard",
    "category": "GraphicsAndDesign",
    "shortDescription": "Minecraft thumbnail studio",
    "longDescription": "Desktop thumbnail studio for Minecraft creators: accurate 3D biome scenes, player skins, text and media layers.",
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../resources/dev/": "model-dumper/dev/",
      "../resources/models/selfie_segmenter.tflite": "mediapipe/selfie_segmenter.tflite",
      "../node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.js": "mediapipe/vision_wasm_internal.js",
      "../node_modules/@mediapipe/tasks-vision/wasm/vision_wasm_internal.wasm": "mediapipe/vision_wasm_internal.wasm",
      "../resources/secret/vision.glb": "secret/vision.glb",
      "../resources/secret/builds.glb": "secret/builds.glb",
      "../resources/secret/boss.glb": "secret/boss.glb",
      "../resources/secret/glasses.glb": "secret/glasses.glb",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../LICENSE": "LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": ["https://github.com/Loveguard/ThumbCraft/releases/latest/download/latest.json"]
    }
  }
}
