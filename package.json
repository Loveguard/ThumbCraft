{
  "name": "thumbcraft",
  "productName": "ThumbCraft",
  "version": "0.1.0",
  "description": "Desktop thumbnail studio for Minecraft creators: accurate 3D biome scenes, player skins, text and media layers.",
  "main": "out/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\"",
    "build:dumper": "javac --release 17 -d resources tools/model-dumper/dev/blockframe/dumper/ModelDumper.java",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@fontsource/titan-one": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.1.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.52.0",
    "postprocessing": "^6.39.5",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "zustand": "^5.0.15"
  }
}
